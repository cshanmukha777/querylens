{
  "name": "@cshanmukha777/querylens",
  "version": "0.1.0",
  "description": "Static SQL analysis and database-aware query profiling for Node.js.",
  "license": "MIT",
  "author": "cshanmukha777",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cshanmukha777/querylens.git"
  },
  "bugs": {
    "url": "https://github.com/cshanmukha777/querylens/issues"
  },
  "homepage": "https://github.com/cshanmukha777/querylens#readme",
  "keywords": [
    "sql",
    "query-analysis",
    "sqlite",
    "postgresql",
    "mysql",
    "query-profiler"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "querylens": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "node-sql-parser": "^5.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "better-sqlite3": "^12.4.1",
    "eslint": "^10.15.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.27.7": true
  }
}
